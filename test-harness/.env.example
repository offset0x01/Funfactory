# Copy to test-harness/.env (or pass --env) and fill in. Only the bots you configure will run.
# Never commit .env: it holds keys (it is in .gitignore).

# LiteLLM proxy (OpenAI-compatible), with DeepInfra behind it
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-your-litellm-key

# Quick-Pick Bot (enum): a small, fast model name as LiteLLM knows it
ENUM_MODEL=deepinfra/Qwen/Qwen3.5-9B

# Thinking Bot (llm): per-move model and between-pass reviewer (both default to ENUM_MODEL)
# LLM_DECIDE_MODEL=deepinfra/Qwen/Qwen3.5-9B
# LLM_REFLECT_MODEL=deepinfra/deepseek-ai/DeepSeek-V4.1-Flash

# Optional JSON merged into every chat request, e.g. to turn off a model's "thinking" mode
# CHAT_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Jev Bot (TypeSafe AI) via a SystemOne endpoint (default: OpenRouter)
JEV_URL=https://openrouter.ai/api/v1/systemone
# JEV_API_KEY=sk-or-your-openrouter-key
JEV_MODEL=jev-latest
